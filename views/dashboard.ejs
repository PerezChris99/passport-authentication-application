<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-4">
  <%- include('partials/messages') %>
  
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-1">Dashboard</h1>
          <p class="text-muted mb-0">Welcome back, <%= user.firstName || user.username %>!</p>
        </div>
        <div>
          <span class="badge bg-<%= user.isVerified ? 'success' : 'warning' %>">
            <%= user.isVerified ? 'Verified' : 'Unverified' %>
          </span>
          <% if (user.role === 'admin') { %>
            <span class="badge bg-danger">Admin</span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row g-4">
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
              <i class="bi bi-person text-primary fs-4"></i>
            </div>
            <div>
              <h6 class="card-subtitle text-muted">Account</h6>
              <h5 class="card-title mb-0"><%= user.username %></h5>
            </div>
          </div>
          <p class="card-text text-muted small">
            <i class="bi bi-envelope"></i> <%= user.email %><br>
            <i class="bi bi-calendar"></i> Member since <%= new Date(user.date).toLocaleDateString() %>
          </p>
          <a href="/users/profile" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil"></i> Edit Profile
          </a>
        </div>
      </div>
    </div>
    
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
              <i class="bi bi-shield-check text-success fs-4"></i>
            </div>
            <div>
              <h6 class="card-subtitle text-muted">Security</h6>
              <h5 class="card-title mb-0">Account Security</h5>
            </div>
          </div>
          <ul class="list-unstyled mb-3">
            <li class="mb-2">
              <i class="bi bi-<%= user.isVerified ? 'check-circle text-success' : 'x-circle text-danger' %>"></i>
              Email Verification
            </li>
            <li class="mb-2">
              <i class="bi bi-<%= user.twoFactorEnabled ? 'check-circle text-success' : 'x-circle text-warning' %>"></i>
              Two-Factor Authentication
            </li>
          </ul>
          <% if (!user.twoFactorEnabled) { %>
            <a href="/auth/2fa/setup" class="btn btn-outline-success btn-sm">
              <i class="bi bi-shield-plus"></i> Enable 2FA
            </a>
          <% } %>
        </div>
      </div>
    </div>
    
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
              <i class="bi bi-lightning text-info fs-4"></i>
            </div>
            <div>
              <h6 class="card-subtitle text-muted">Quick Actions</h6>
              <h5 class="card-title mb-0">Shortcuts</h5>
            </div>
          </div>
          <div class="d-grid gap-2">
            <a href="/auth/change-password" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-key"></i> Change Password
            </a>
            <a href="/users/activity" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-activity"></i> Activity Log
            </a>
            <a href="/users/settings" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-gear"></i> Settings
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <% if (user.role === 'admin') { %>
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm bg-dark text-white">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-gear-wide-connected"></i> Admin Panel</h5>
          <p class="card-text">You have administrator privileges. Access the admin panel to manage users and view system logs.</p>
          <a href="/admin" class="btn btn-light"><i class="bi bi-speedometer2"></i> Go to Admin Panel</a>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
