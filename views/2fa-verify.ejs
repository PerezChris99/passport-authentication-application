<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <i class="bi bi-shield-lock display-4 text-primary"></i>
            <h2 class="mt-2">Two-Factor Verification</h2>
            <p class="text-muted">Enter the verification code to continue.</p>
          </div>
          
          <%- include('partials/messages') %>
          
          <form action="/auth/2fa-verify" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="mb-4">
              <label for="token" class="form-label">Verification Code</label>
              <input type="text" class="form-control form-control-lg text-center" 
                     id="token" name="token" 
                     pattern="[0-9]{6}" maxlength="6" 
                     placeholder="000000" 
                     autocomplete="one-time-code"
                     required autofocus>
              <div class="form-text">Enter the 6-digit code from your authenticator app or email.</div>
            </div>
            
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-check-circle"></i> Verify
            </button>
          </form>
          
          <hr class="my-4">
          
          <p class="text-center text-muted small mb-0">
            <a href="/auth/login">Cancel and return to login</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
