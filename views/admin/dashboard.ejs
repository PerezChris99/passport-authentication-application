<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-lg-2 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="text-muted text-uppercase small mb-3">Admin Menu</h6>
          <nav class="nav flex-column">
            <a class="nav-link active" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link" href="/admin/users"><i class="bi bi-people"></i> Users</a>
            <a class="nav-link" href="/admin/audit-logs"><i class="bi bi-journal-text"></i> Audit Logs</a>
            <a class="nav-link" href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
            <hr>
            <a class="nav-link text-muted" href="/dashboard"><i class="bi bi-arrow-left"></i> Back to App</a>
          </nav>
        </div>
      </div>
    </div>
    
    <!-- Main Content -->
    <div class="col-lg-10">
      <%- include('../partials/messages') %>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-speedometer2"></i> Admin Dashboard</h2>
        <span class="text-muted">Welcome, <%= user.username %></span>
      </div>
      
      <!-- Stats Cards -->
      <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <p class="text-muted mb-1">Total Users</p>
                  <h3 class="mb-0"><%= stats.totalUsers %></h3>
                </div>
                <div class="bg-primary bg-opacity-10 rounded p-3">
                  <i class="bi bi-people text-primary fs-4"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <p class="text-muted mb-1">Verified Users</p>
                  <h3 class="mb-0"><%= stats.verifiedUsers %></h3>
                </div>
                <div class="bg-success bg-opacity-10 rounded p-3">
                  <i class="bi bi-person-check text-success fs-4"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <p class="text-muted mb-1">Locked Accounts</p>
                  <h3 class="mb-0"><%= stats.lockedUsers %></h3>
                </div>
                <div class="bg-danger bg-opacity-10 rounded p-3">
                  <i class="bi bi-person-lock text-danger fs-4"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <p class="text-muted mb-1">Logins (24h)</p>
                  <h3 class="mb-0"><%= stats.recentLogins %></h3>
                </div>
                <div class="bg-info bg-opacity-10 rounded p-3">
                  <i class="bi bi-box-arrow-in-right text-info fs-4"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Quick Actions -->
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
              <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-2">
                <a href="/admin/users" class="btn btn-outline-primary">
                  <i class="bi bi-people"></i> Manage Users
                </a>
                <a href="/admin/audit-logs" class="btn btn-outline-secondary">
                  <i class="bi bi-journal-text"></i> View Audit Logs
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
              <h5 class="mb-0">System Info</h5>
            </div>
            <div class="card-body">
              <table class="table table-sm mb-0">
                <tr>
                  <td class="text-muted">Node.js Version</td>
                  <td><%= process.version %></td>
                </tr>
                <tr>
                  <td class="text-muted">Environment</td>
                  <td><%= process.env.NODE_ENV || 'development' %></td>
                </tr>
                <tr>
                  <td class="text-muted">New Users (24h)</td>
                  <td><%= stats.recentRegistrations %></td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
