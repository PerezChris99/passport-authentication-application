<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-lg-2 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="text-muted text-uppercase small mb-3">Admin Menu</h6>
          <nav class="nav flex-column">
            <a class="nav-link" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link active" href="/admin/users"><i class="bi bi-people"></i> Users</a>
            <a class="nav-link" href="/admin/audit-logs"><i class="bi bi-journal-text"></i> Audit Logs</a>
            <a class="nav-link" href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
            <hr>
            <a class="nav-link text-muted" href="/dashboard"><i class="bi bi-arrow-left"></i> Back to App</a>
          </nav>
        </div>
      </div>
    </div>
    
    <!-- Main Content -->
    <div class="col-lg-10">
      <%- include('../partials/messages') %>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Users</h2>
        <span class="badge bg-primary"><%= pagination.total %> total</span>
      </div>
      
      <!-- Search -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <form action="/admin/users" method="GET" class="row g-3">
            <div class="col-md-10">
              <input type="text" class="form-control" name="search" 
                     value="<%= search %>" placeholder="Search by username, email, or name...">
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Search
              </button>
            </div>
          </form>
        </div>
      </div>
      
      <!-- Users Table -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>User</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Joined</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <div class="bg-secondary bg-opacity-10 rounded-circle p-2 me-2">
                          <i class="bi bi-person"></i>
                        </div>
                        <div>
                          <strong><%= u.username %></strong>
                          <% if (u.firstName || u.lastName) { %>
                            <br><small class="text-muted"><%= u.firstName %> <%= u.lastName %></small>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td><%= u.email %></td>
                    <td>
                      <span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'secondary' %>">
                        <%= u.role %>
                      </span>
                    </td>
                    <td>
                      <% if (u.accountLocked) { %>
                        <span class="badge bg-danger">Locked</span>
                      <% } else if (u.isVerified) { %>
                        <span class="badge bg-success">Verified</span>
                      <% } else { %>
                        <span class="badge bg-warning">Unverified</span>
                      <% } %>
                      <% if (u.twoFactorEnabled) { %>
                        <span class="badge bg-info">2FA</span>
                      <% } %>
                    </td>
                    <td><small><%= new Date(u.date).toLocaleDateString() %></small></td>
                    <td>
                      <a href="/admin/users/<%= u._id %>" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        
        <% if (pagination.totalPages > 1) { %>
          <div class="card-footer bg-white">
            <nav>
              <ul class="pagination pagination-sm mb-0 justify-content-center">
                <li class="page-item <%= pagination.hasPrev ? '' : 'disabled' %>">
                  <a class="page-link" href="?page=<%= pagination.page - 1 %>&search=<%= search %>">Previous</a>
                </li>
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                  <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
                  </li>
                <% } %>
                <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
                  <a class="page-link" href="?page=<%= pagination.page + 1 %>&search=<%= search %>">Next</a>
                </li>
              </ul>
            </nav>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
