<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-lg-2 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="text-muted text-uppercase small mb-3">Admin Menu</h6>
          <nav class="nav flex-column">
            <a class="nav-link" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link active" href="/admin/users"><i class="bi bi-people"></i> Users</a>
            <a class="nav-link" href="/admin/audit-logs"><i class="bi bi-journal-text"></i> Audit Logs</a>
            <a class="nav-link" href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
            <hr>
            <a class="nav-link text-muted" href="/dashboard"><i class="bi bi-arrow-left"></i> Back to App</a>
          </nav>
        </div>
      </div>
    </div>
    
    <!-- Main Content -->
    <div class="col-lg-10">
      <%- include('../partials/messages') %>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <a href="/admin/users" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Users
          </a>
          <h2><i class="bi bi-person"></i> User Details</h2>
        </div>
      </div>
      
      <div class="row g-4">
        <div class="col-md-4">
          <!-- User Info Card -->
          <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                <i class="bi bi-person-fill text-primary" style="font-size: 3rem;"></i>
              </div>
              <h4><%= targetUser.username %></h4>
              <p class="text-muted"><%= targetUser.email %></p>
              <div class="mb-3">
                <span class="badge bg-<%= targetUser.role === 'admin' ? 'danger' : 'secondary' %>">
                  <%= targetUser.role %>
                </span>
                <% if (targetUser.isVerified) { %>
                  <span class="badge bg-success">Verified</span>
                <% } else { %>
                  <span class="badge bg-warning">Unverified</span>
                <% } %>
                <% if (targetUser.accountLocked) { %>
                  <span class="badge bg-danger">Locked</span>
                <% } %>
                <% if (targetUser.twoFactorEnabled) { %>
                  <span class="badge bg-info">2FA Enabled</span>
                <% } %>
              </div>
              <hr>
              <p class="small text-muted mb-1">
                <i class="bi bi-calendar"></i> Joined: <%= new Date(targetUser.date).toLocaleDateString() %>
              </p>
              <% if (targetUser.lastLogin) { %>
                <p class="small text-muted mb-0">
                  <i class="bi bi-clock"></i> Last Login: <%= new Date(targetUser.lastLogin).toLocaleString() %>
                </p>
              <% } %>
            </div>
          </div>
          
          <% if (targetUser.accountLocked) { %>
            <div class="card border-0 shadow-sm mt-3 border-warning">
              <div class="card-body">
                <h6 class="text-warning"><i class="bi bi-lock"></i> Account Locked</h6>
                <p class="small mb-2">Failed attempts: <%= targetUser.failedLoginAttempts %></p>
                <form action="/admin/users/<%= targetUser._id %>/unlock" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-warning btn-sm w-100">
                    <i class="bi bi-unlock"></i> Unlock Account
                  </button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
        
        <div class="col-md-8">
          <!-- Edit Form -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
              <h5 class="mb-0">Edit User</h5>
            </div>
            <div class="card-body">
              <form action="/admin/users/<%= targetUser._id %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <select name="role" class="form-select">
                      <option value="user" <%= targetUser.role === 'user' ? 'selected' : '' %>>User</option>
                      <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Email Verified</label>
                    <select name="isVerified" class="form-select">
                      <option value="true" <%= targetUser.isVerified ? 'selected' : '' %>>Yes</option>
                      <option value="false" <%= !targetUser.isVerified ? 'selected' : '' %>>No</option>
                    </select>
                  </div>
                </div>
                
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-check"></i> Save Changes
                </button>
              </form>
            </div>
          </div>
          
          <!-- Recent Activity -->
          <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white">
              <h5 class="mb-0">Recent Activity</h5>
            </div>
            <div class="card-body p-0">
              <% if (recentActivity && recentActivity.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-sm mb-0">
                    <thead class="table-light">
                      <tr>
                        <th>Action</th>
                        <th>Status</th>
                        <th>IP</th>
                        <th>Date</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% recentActivity.forEach(function(activity) { %>
                        <tr>
                          <td><%= activity.action %></td>
                          <td>
                            <span class="badge bg-<%= activity.status === 'success' ? 'success' : 'danger' %>">
                              <%= activity.status %>
                            </span>
                          </td>
                          <td><code><%= activity.ipAddress %></code></td>
                          <td><small><%= new Date(activity.createdAt).toLocaleString() %></small></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-muted text-center py-3 mb-0">No activity recorded</p>
              <% } %>
            </div>
          </div>
          
          <!-- Danger Zone -->
          <div class="card border-0 shadow-sm mt-3 border-danger">
            <div class="card-header bg-danger text-white">
              <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Danger Zone</h5>
            </div>
            <div class="card-body">
              <p class="text-muted small">Deleting this user will permanently remove all their data.</p>
              <form action="/admin/users/<%= targetUser._id %>/delete" method="POST" 
                    onsubmit="return confirm('Are you sure you want to delete this user?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i> Delete User
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
