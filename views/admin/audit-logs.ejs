<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-lg-2 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="text-muted text-uppercase small mb-3">Admin Menu</h6>
          <nav class="nav flex-column">
            <a class="nav-link" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="nav-link" href="/admin/users"><i class="bi bi-people"></i> Users</a>
            <a class="nav-link active" href="/admin/audit-logs"><i class="bi bi-journal-text"></i> Audit Logs</a>
            <a class="nav-link" href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
            <hr>
            <a class="nav-link text-muted" href="/dashboard"><i class="bi bi-arrow-left"></i> Back to App</a>
          </nav>
        </div>
      </div>
    </div>
    
    <!-- Main Content -->
    <div class="col-lg-10">
      <%- include('../partials/messages') %>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-journal-text"></i> Audit Logs</h2>
        <span class="badge bg-primary"><%= pagination.total %> total</span>
      </div>
      
      <!-- Filters -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <form action="/admin/audit-logs" method="GET" class="row g-3">
            <div class="col-md-10">
              <select name="action" class="form-select">
                <option value="">All Actions</option>
                <% actionTypes.forEach(function(action) { %>
                  <option value="<%= action %>" <%= selectedAction === action ? 'selected' : '' %>>
                    <%= action %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-filter"></i> Filter
              </button>
            </div>
          </form>
        </div>
      </div>
      
      <!-- Logs Table -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Action</th>
                  <th>User</th>
                  <th>Status</th>
                  <th>IP Address</th>
                  <th>Details</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% logs.forEach(function(log) { %>
                  <tr>
                    <td>
                      <code><%= log.action %></code>
                    </td>
                    <td>
                      <% if (log.userId) { %>
                        <a href="/admin/users/<%= log.userId._id %>">
                          <%= log.userId.username || log.userId.email %>
                        </a>
                      <% } else { %>
                        <span class="text-muted">Anonymous</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge bg-<%= log.status === 'success' ? 'success' : log.status === 'failure' ? 'danger' : 'warning' %>">
                        <%= log.status %>
                      </span>
                    </td>
                    <td><code><%= log.ipAddress %></code></td>
                    <td>
                      <% if (log.details && Object.keys(log.details).length > 0) { %>
                        <button class="btn btn-sm btn-outline-secondary" type="button" 
                                data-bs-toggle="collapse" data-bs-target="#details-<%= log._id %>">
                          <i class="bi bi-eye"></i>
                        </button>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <small><%= new Date(log.createdAt).toLocaleString() %></small>
                    </td>
                  </tr>
                  <% if (log.details && Object.keys(log.details).length > 0) { %>
                    <tr class="collapse" id="details-<%= log._id %>">
                      <td colspan="6" class="bg-light">
                        <pre class="mb-0 small"><%= JSON.stringify(log.details, null, 2) %></pre>
                      </td>
                    </tr>
                  <% } %>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        
        <% if (pagination.totalPages > 1) { %>
          <div class="card-footer bg-white">
            <nav>
              <ul class="pagination pagination-sm mb-0 justify-content-center">
                <li class="page-item <%= pagination.hasPrev ? '' : 'disabled' %>">
                  <a class="page-link" href="?page=<%= pagination.page - 1 %>&action=<%= selectedAction %>">Previous</a>
                </li>
                <% for (let i = Math.max(1, pagination.page - 2); i <= Math.min(pagination.totalPages, pagination.page + 2); i++) { %>
                  <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&action=<%= selectedAction %>"><%= i %></a>
                  </li>
                <% } %>
                <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
                  <a class="page-link" href="?page=<%= pagination.page + 1 %>&action=<%= selectedAction %>">Next</a>
                </li>
              </ul>
            </nav>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
