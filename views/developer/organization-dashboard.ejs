<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= org.name %> | Developer Portal</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/developer.css">
</head>
<body>
    <div class="dev-layout">
        <aside class="dev-sidebar">
            <div class="dev-sidebar-logo">
                <h1><%= org.name %></h1>
                <span><%= org.slug %></span>
            </div>
            
            <nav class="dev-nav">
                <div class="dev-nav-section">
                    <div class="dev-nav-section-title">Overview</div>
                    <a href="/developer/<%= org.slug %>" class="dev-nav-link active">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        Dashboard
                    </a>
                </div>
                
                <div class="dev-nav-section">
                    <div class="dev-nav-section-title">Build</div>
                    <a href="/developer/<%= org.slug %>/applications" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                        </svg>
                        Applications
                    </a>
                    <a href="/developer/<%= org.slug %>/api-keys" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                        </svg>
                        API Keys
                    </a>
                    <a href="/developer/<%= org.slug %>/webhooks" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                        </svg>
                        Webhooks
                    </a>
                </div>
                
                <div class="dev-nav-section">
                    <div class="dev-nav-section-title">Monitor</div>
                    <a href="/developer/<%= org.slug %>/logs" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        Logs
                    </a>
                    <a href="/developer/<%= org.slug %>/analytics" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        Analytics
                    </a>
                </div>
                
                <div class="dev-nav-section">
                    <div class="dev-nav-section-title">Settings</div>
                    <a href="/developer/<%= org.slug %>/team" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                        Team
                    </a>
                    <a href="/developer/<%= org.slug %>/settings" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        Settings
                    </a>
                </div>
                
                <div class="dev-nav-section">
                    <a href="/developer" class="dev-nav-link">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
                        </svg>
                        All Organizations
                    </a>
                </div>
            </nav>
        </aside>
        
        <main class="dev-content">
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success">
                    <%= success_msg %>
                </div>
            <% } %>
            
            <div class="dev-header">
                <div>
                    <h1><%= org.name %></h1>
                    <p class="dev-header-subtitle">Organization Dashboard</p>
                </div>
                <div class="dev-header-actions">
                    <a href="/developer/<%= org.slug %>/applications/new" class="btn-primary">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                        </svg>
                        New Application
                    </a>
                </div>
            </div>
            
            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Applications</h3>
                    <div class="value"><%= applications.length %></div>
                </div>
                <div class="stat-card">
                    <h3>API Keys</h3>
                    <div class="value"><%= apiKeys.length %></div>
                </div>
                <div class="stat-card">
                    <h3>Webhooks</h3>
                    <div class="value"><%= webhooks.length %></div>
                </div>
                <div class="stat-card">
                    <h3>Your Role</h3>
                    <div class="value value-small"><%= userRole %></div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h2>Quick Actions</h2>
                </div>
                <div class="card-body">
                    <div class="quick-actions">
                        <a href="/developer/<%= org.slug %>/applications/new" class="quick-action">
                            <div class="quick-action-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                </svg>
                            </div>
                            <div>
                                <h3>Create Application</h3>
                                <p>Register a new OAuth app</p>
                            </div>
                        </a>
                        <a href="/developer/<%= org.slug %>/api-keys" class="quick-action">
                            <div class="quick-action-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                                </svg>
                            </div>
                            <div>
                                <h3>Generate API Key</h3>
                                <p>Create key for server access</p>
                            </div>
                        </a>
                        <a href="/developer/<%= org.slug %>/webhooks" class="quick-action">
                            <div class="quick-action-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                                </svg>
                            </div>
                            <div>
                                <h3>Add Webhook</h3>
                                <p>Subscribe to events</p>
                            </div>
                        </a>
                        <a href="/docs" class="quick-action">
                            <div class="quick-action-icon green">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                </svg>
                            </div>
                            <div>
                                <h3>View Docs</h3>
                                <p>Integration guides</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h2>Applications</h2>
                    <a href="/developer/<%= org.slug %>/applications" class="btn-secondary btn-sm">View All</a>
                </div>
                <div class="card-body card-body-flush">
                    <% if (applications.length > 0) { %>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Client ID</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% applications.slice(0, 5).forEach(app => { %>
                                    <tr>
                                        <td>
                                            <a href="/developer/<%= org.slug %>/applications/<%= app.clientId %>" class="table-link">
                                                <%= app.name %>
                                            </a>
                                        </td>
                                        <td><%= app.type %></td>
                                        <td><code class="table-code"><%= app.clientId %></code></td>
                                        <td>
                                            <span class="badge badge-<%= app.status === 'active' ? 'success' : 'warning' %>">
                                                <%= app.status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z"/>
                            </svg>
                            <h3>No applications yet</h3>
                            <p>Create your first application to start integrating.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h2>Recent Activity</h2>
                    <a href="/developer/<%= org.slug %>/logs" class="btn-secondary btn-sm">View All</a>
                </div>
                <div class="card-body card-body-flush">
                    <% if (recentLogs.length > 0) { %>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Event</th>
                                    <th>Status</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentLogs.forEach(log => { %>
                                    <tr>
                                        <td><%= log.action %></td>
                                        <td>
                                            <span class="badge badge-<%= log.status === 'success' ? 'success' : 'danger' %>">
                                                <%= log.status %>
                                            </span>
                                        </td>
                                        <td><%= new Date(log.createdAt).toLocaleString() %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="empty-state">
                            <p>No recent activity</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
