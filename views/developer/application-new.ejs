<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Application | <%= org.name %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/developer.css">
</head>
<body>
    <div class="create-page">
        <div class="create-container">
            <a href="/developer/<%= org.slug %>/applications" class="back-link">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Applications
            </a>
            
            <div class="create-header">
                <h1>Create Application</h1>
                <p>Register a new application for <%= org.name %></p>
            </div>
            
            <div class="create-card">
                <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                    <div class="error-list">
                        <ul>
                            <% errors.forEach(error => { %>
                                <li><%= error.msg %></li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>
                
                <form action="/developer/<%= org.slug %>/applications" method="POST">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    
                    <div class="form-group">
                        <label for="name">Application Name *</label>
                        <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            value="<%= typeof values !== 'undefined' ? values.name || '' : '' %>"
                            placeholder="My Awesome App"
                            required
                            autofocus
                        >
                        <small>This name will be shown to users during authorization</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Application Type *</label>
                        <div class="app-types">
                            <div class="app-type">
                                <input type="radio" id="type-web" name="type" value="web" checked>
                                <label for="type-web">
                                    <div class="app-type-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                                        </svg>
                                    </div>
                                    <h3>Web Application</h3>
                                    <p>Traditional server-rendered app</p>
                                </label>
                            </div>
                            <div class="app-type">
                                <input type="radio" id="type-spa" name="type" value="spa">
                                <label for="type-spa">
                                    <div class="app-type-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <h3>Single-Page App</h3>
                                    <p>React, Vue, Angular, etc.</p>
                                </label>
                            </div>
                            <div class="app-type">
                                <input type="radio" id="type-native" name="type" value="native">
                                <label for="type-native">
                                    <div class="app-type-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <h3>Native/Desktop</h3>
                                    <p>Desktop or CLI application</p>
                                </label>
                            </div>
                            <div class="app-type">
                                <input type="radio" id="type-mobile" name="type" value="mobile">
                                <label for="type-mobile">
                                    <div class="app-type-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <h3>Mobile App</h3>
                                    <p>iOS or Android</p>
                                </label>
                            </div>
                            <div class="app-type">
                                <input type="radio" id="type-m2m" name="type" value="machine-to-machine">
                                <label for="type-m2m">
                                    <div class="app-type-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                                        </svg>
                                    </div>
                                    <h3>Machine-to-Machine</h3>
                                    <p>Backend services, APIs</p>
                                </label>
                            </div>
                            <div class="app-type">
                                <input type="radio" id="type-api" name="type" value="api">
                                <label for="type-api">
                                    <div class="app-type-icon">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                    <h3>API</h3>
                                    <p>Protected API resource</p>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea 
                            id="description" 
                            name="description"
                            placeholder="Brief description of your application..."
                        ><%= typeof values !== 'undefined' ? values.description || '' : '' %></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="redirectUris">Allowed Callback URLs</label>
                        <textarea 
                            id="redirectUris" 
                            name="redirectUris"
                            placeholder="https://myapp.com/callback&#10;http://localhost:3000/callback"
                        ><%= typeof values !== 'undefined' ? values.redirectUris || '' : '' %></textarea>
                        <small>One URL per line. For OAuth redirects after login.</small>
                    </div>
                    
                    <div class="form-actions">
                        <a href="/developer/<%= org.slug %>/applications" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
