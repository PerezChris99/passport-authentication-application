<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-4">
  <%- include('partials/messages') %>
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-activity"></i> Activity Log</h2>
    <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left"></i> Back
    </a>
  </div>
  
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if (activities && activities.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Action</th>
                <th>Status</th>
                <th>IP Address</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% activities.forEach(function(activity) { %>
                <tr>
                  <td>
                    <% 
                      const actionIcons = {
                        'LOGIN_SUCCESS': 'box-arrow-in-right text-success',
                        'LOGIN_FAILURE': 'box-arrow-in-right text-danger',
                        'LOGOUT': 'box-arrow-right text-secondary',
                        'PASSWORD_CHANGE': 'key text-warning',
                        'PASSWORD_RESET_REQUEST': 'key text-info',
                        'PASSWORD_RESET_SUCCESS': 'key text-success',
                        '2FA_ENABLED': 'shield-check text-success',
                        '2FA_DISABLED': 'shield-x text-warning',
                        '2FA_VERIFIED': 'shield-lock text-success',
                        '2FA_FAILED': 'shield-exclamation text-danger',
                        'PROFILE_UPDATE': 'person text-info',
                        'REGISTER': 'person-plus text-primary'
                      };
                      const icon = actionIcons[activity.action] || 'circle text-secondary';
                    %>
                    <i class="bi bi-<%= icon %>"></i>
                    <%= activity.action.replace(/_/g, ' ') %>
                  </td>
                  <td>
                    <span class="badge bg-<%= activity.status === 'success' ? 'success' : activity.status === 'failure' ? 'danger' : 'warning' %>">
                      <%= activity.status %>
                    </span>
                  </td>
                  <td><code><%= activity.ipAddress %></code></td>
                  <td>
                    <small class="text-muted">
                      <%= new Date(activity.createdAt).toLocaleString() %>
                    </small>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="bi bi-inbox display-4 text-muted"></i>
          <p class="text-muted mt-3">No activity recorded yet.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
