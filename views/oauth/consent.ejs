<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authorize | <%= application.name %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/auth-pages.css">
</head>
<body>
    <div class="consent-page">
        <div class="consent-container">
            <div class="consent-card">
                <div class="consent-header">
                    <div class="app-icon">
                        <% if (application.branding && application.branding.logoUrl) { %>
                            <img src="<%= application.branding.logoUrl %>" alt="<%= application.name %>">
                        <% } else { %>
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        <% } %>
                    </div>
                    <h1><%= application.name %></h1>
                    <p>wants to access your account</p>
                </div>
                
                <div class="consent-body">
                    <div class="user-info">
                        <div class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                        <span><%= user.email %></span>
                    </div>
                    
                    <p class="consent-body-text">
                        This will allow <strong><%= application.name %></strong> to:
                    </p>
                    
                    <ul class="scope-list">
                        <% scopes.forEach(scope => { %>
                            <li class="scope-item">
                                <div class="scope-icon">
                                    <% if (scope === 'profile') { %>
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </svg>
                                    <% } else if (scope === 'email') { %>
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </svg>
                                    <% } else if (scope === 'openid') { %>
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                                        </svg>
                                    <% } else { %>
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    <% } %>
                                </div>
                                <div class="scope-info">
                                    <h3><%= scope %></h3>
                                    <p><%= scopeDescriptions[scope] || 'Access to ' + scope %></p>
                                </div>
                            </li>
                        <% }) %>
                    </ul>
                </div>
                
                <form action="/oauth/authorize" method="POST">
                    <!-- Hidden OAuth params -->
                    <input type="hidden" name="client_id" value="<%= params.client_id %>">
                    <input type="hidden" name="redirect_uri" value="<%= params.redirect_uri %>">
                    <input type="hidden" name="response_type" value="<%= params.response_type %>">
                    <input type="hidden" name="scope" value="<%= params.scope %>">
                    <% if (params.state) { %>
                        <input type="hidden" name="state" value="<%= params.state %>">
                    <% } %>
                    <% if (params.nonce) { %>
                        <input type="hidden" name="nonce" value="<%= params.nonce %>">
                    <% } %>
                    <% if (params.code_challenge) { %>
                        <input type="hidden" name="code_challenge" value="<%= params.code_challenge %>">
                        <input type="hidden" name="code_challenge_method" value="<%= params.code_challenge_method || 'plain' %>">
                    <% } %>
                    
                    <div class="consent-footer">
                        <button type="submit" name="decision" value="deny" class="btn btn-deny">
                            Deny
                        </button>
                        <button type="submit" name="decision" value="allow" class="btn btn-allow">
                            Allow
                        </button>
                    </div>
                </form>
            </div>
            
            <div class="trust-info">
                Powered by AuthService &bull; <a href="/privacy">Privacy Policy</a>
            </div>
        </div>
    </div>
</body>
</html>
