<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold mb-1">
            <i class="bi bi-fingerprint me-2"></i>Manage Passkeys
          </h2>
          <p class="text-muted mb-0">Add or remove passkeys for passwordless sign-in</p>
        </div>
        <a href="/webauthn/register" class="btn btn-primary">
          <i class="bi bi-plus-lg me-2"></i>Add Passkey
        </a>
      </div>

      <%- include('../partials/messages') %>

      <div class="card shadow-sm">
        <div class="card-body p-0">
          <% if (passkeys && passkeys.length > 0) { %>
            <div class="list-group list-group-flush" id="passkey-list">
              <% passkeys.forEach(function(passkey) { %>
                <div class="list-group-item passkey-item" data-id="<%= passkey._id %>">
                  <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex align-items-center">
                      <div class="passkey-icon-wrapper me-3">
                        <% if (passkey.authenticatorType === 'platform') { %>
                          <i class="bi bi-laptop fs-4 text-primary"></i>
                        <% } else { %>
                          <i class="bi bi-key fs-4 text-primary"></i>
                        <% } %>
                      </div>
                      <div>
                        <h6 class="mb-0 passkey-name">
                          <span class="name-text"><%= passkey.name %></span>
                          <button class="btn btn-sm btn-link p-0 ms-2 edit-name-btn" title="Rename">
                            <i class="bi bi-pencil"></i>
                          </button>
                        </h6>
                        <small class="text-muted d-block">
                          <% if (passkey.deviceInfo) { %>
                            <%= passkey.deviceInfo.platform %> 
                            <% if (passkey.deviceInfo.browser) { %>
                              &middot; <%= passkey.deviceInfo.browser %>
                            <% } %>
                          <% } %>
                        </small>
                        <small class="text-muted">
                          Added <%= new Date(passkey.createdAt).toLocaleDateString() %>
                          <% if (passkey.lastUsedAt) { %>
                            &middot; Last used <%= new Date(passkey.lastUsedAt).toLocaleDateString() %>
                          <% } %>
                          <% if (passkey.useCount > 0) { %>
                            &middot; Used <%= passkey.useCount %> times
                          <% } %>
                        </small>
                        <div class="passkey-badges mt-1">
                          <% if (passkey.backupEligible) { %>
                            <span class="badge bg-info-subtle text-info">
                              <i class="bi bi-cloud-check me-1"></i>Synced
                            </span>
                          <% } %>
                          <% if (passkey.transports && passkey.transports.length > 0) { %>
                            <% passkey.transports.forEach(function(transport) { %>
                              <span class="badge bg-secondary-subtle text-secondary">
                                <%= transport %>
                              </span>
                            <% }) %>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <button class="btn btn-outline-danger btn-sm delete-passkey-btn" 
                            data-id="<%= passkey._id %>" 
                            data-name="<%= passkey.name %>">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <div class="mb-3">
                <i class="bi bi-fingerprint fs-1 text-muted"></i>
              </div>
              <h5 class="mb-2">No Passkeys Yet</h5>
              <p class="text-muted mb-4">Add a passkey to enable passwordless sign-in</p>
              <a href="/webauthn/register" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Add Your First Passkey
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <div class="card mt-4">
        <div class="card-body">
          <h6 class="fw-semibold mb-3">
            <i class="bi bi-info-circle me-2"></i>About Passkeys
          </h6>
          <div class="row">
            <div class="col-md-6">
              <ul class="small text-muted mb-0">
                <li class="mb-2">Passkeys replace passwords with biometrics or a PIN</li>
                <li class="mb-2">They use your device's built-in security (Face ID, Touch ID, Windows Hello)</li>
                <li>Passkeys are phishing-resistant and more secure than passwords</li>
              </ul>
            </div>
            <div class="col-md-6">
              <ul class="small text-muted mb-0">
                <li class="mb-2">Synced passkeys backup to your cloud account (iCloud, Google)</li>
                <li class="mb-2">You can use passkeys across all your devices</li>
                <li>Even with passkeys, you can still sign in with your password</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <a href="/settings" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-2"></i>Back to Settings
        </a>
        <a href="/webauthn/login" class="btn btn-outline-primary" target="_blank">
          <i class="bi bi-box-arrow-up-right me-2"></i>Test Passkey Login
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Rename Modal -->
<div class="modal fade" id="renameModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Rename Passkey</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="text" class="form-control" id="newPasskeyName" maxlength="100" placeholder="Enter new name">
        <input type="hidden" id="renamePasskeyId">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveNameBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Remove Passkey</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to remove "<span id="deletePasskeyName"></span>"?</p>
        <p class="text-muted small mb-0">This passkey will no longer work for signing in.</p>
        <input type="hidden" id="deletePasskeyId">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Remove</button>
      </div>
    </div>
  </div>
</div>

<style>
.passkey-icon-wrapper {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(var(--bs-primary-rgb), 0.1);
  border-radius: 12px;
}
.passkey-item {
  transition: background-color 0.2s;
}
.passkey-item:hover {
  background-color: var(--bs-tertiary-bg);
}
.edit-name-btn {
  opacity: 0;
  transition: opacity 0.2s;
}
.passkey-item:hover .edit-name-btn {
  opacity: 1;
}
.passkey-badges .badge {
  font-weight: 500;
  margin-right: 0.25rem;
}
</style>

<script src="/js/webauthn.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const renameModal = new bootstrap.Modal(document.getElementById('renameModal'));
  const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

  // Rename functionality
  document.querySelectorAll('.edit-name-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const item = this.closest('.passkey-item');
      const id = item.dataset.id;
      const currentName = item.querySelector('.name-text').textContent;
      
      document.getElementById('renamePasskeyId').value = id;
      document.getElementById('newPasskeyName').value = currentName;
      renameModal.show();
    });
  });

  document.getElementById('saveNameBtn').addEventListener('click', async function() {
    const id = document.getElementById('renamePasskeyId').value;
    const newName = document.getElementById('newPasskeyName').value.trim();
    
    if (!newName) {
      alert('Please enter a name');
      return;
    }
    
    const result = await renamePasskey(id, newName);
    
    if (result.success) {
      // Update the name in the UI
      const item = document.querySelector(`.passkey-item[data-id="${id}"]`);
      item.querySelector('.name-text').textContent = newName;
      renameModal.hide();
    } else {
      alert(result.message || 'Failed to rename passkey');
    }
  });

  // Delete functionality
  document.querySelectorAll('.delete-passkey-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const id = this.dataset.id;
      const name = this.dataset.name;
      
      document.getElementById('deletePasskeyId').value = id;
      document.getElementById('deletePasskeyName').textContent = name;
      deleteModal.show();
    });
  });

  document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
    const id = document.getElementById('deletePasskeyId').value;
    
    const result = await deletePasskey(id);
    
    if (result.success) {
      // Remove from UI
      const item = document.querySelector(`.passkey-item[data-id="${id}"]`);
      item.remove();
      deleteModal.hide();
      
      // Check if list is empty
      const list = document.getElementById('passkey-list');
      if (list && list.children.length === 0) {
        location.reload(); // Reload to show empty state
      }
    } else {
      alert(result.message || 'Failed to remove passkey');
    }
  });
});
</script>

<%- include('../partials/footer') %>
