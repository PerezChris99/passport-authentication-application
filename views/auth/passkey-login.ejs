<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <div class="passkey-icon mb-3">
              <i class="bi bi-fingerprint"></i>
            </div>
            <h2 class="fw-bold">Sign in with Passkey</h2>
            <p class="text-muted">Use your fingerprint, face, or security key</p>
          </div>

          <%- include('../partials/messages') %>

          <div id="passkey-support-check" class="alert alert-danger d-none">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Not Supported</strong>
            <p class="mb-0 mt-1">Your browser doesn't support passkeys.</p>
          </div>

          <div id="login-form">
            <!-- Discoverable credentials (usernameless) login -->
            <div class="d-grid gap-2 mb-4">
              <button type="button" id="passkey-login-btn" class="btn btn-primary btn-lg">
                <i class="bi bi-fingerprint me-2"></i>Continue with Passkey
              </button>
            </div>

            <div class="divider-text">
              <span>or enter your email</span>
            </div>

            <!-- Email-based passkey lookup -->
            <div class="mb-3">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" class="form-control form-control-lg" id="email" placeholder="name@example.com">
            </div>

            <div class="d-grid">
              <button type="button" id="email-passkey-btn" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-key me-2"></i>Find My Passkeys
              </button>
            </div>
          </div>

          <div id="login-progress" class="text-center d-none">
            <div class="spinner-border text-primary mb-3" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mb-0">Waiting for authentication...</p>
            <small class="text-muted">Complete the authentication on your device</small>
          </div>

          <div id="login-success" class="text-center d-none">
            <div class="success-icon mb-3">
              <i class="bi bi-check-circle-fill text-success"></i>
            </div>
            <h4>Welcome back!</h4>
            <p class="text-muted">Redirecting to dashboard...</p>
          </div>

          <div id="login-error" class="text-center d-none">
            <div class="error-icon mb-3">
              <i class="bi bi-x-circle-fill text-danger"></i>
            </div>
            <h4>Sign In Failed</h4>
            <p class="text-muted" id="error-message">Authentication failed.</p>
            <button type="button" class="btn btn-primary" onclick="resetForm()">Try Again</button>
          </div>

          <hr class="my-4">

          <div class="text-center">
            <p class="mb-2">Don't have a passkey?</p>
            <a href="/auth/login" class="btn btn-outline-secondary">
              <i class="bi bi-box-arrow-in-right me-2"></i>Sign in with Password
            </a>
          </div>

          <div class="text-center mt-3">
            <small class="text-muted">
              Don't have an account? <a href="/auth/register">Register</a>
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="/css/auth-pages.css">
<style>
.passkey-icon {
  font-size: 4rem;
  color: var(--bs-primary);
}
.passkey-icon i {
  display: inline-block;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}
.divider-text {
  display: flex;
  align-items: center;
  text-align: center;
  margin: 1.5rem 0;
}
.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid var(--bs-border-color);
}
.divider-text span {
  padding: 0 1rem;
  color: var(--bs-secondary-color);
  font-size: 0.875rem;
}
.success-icon, .error-icon {
  font-size: 4rem;
}
</style>

<script src="/js/webauthn.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Check WebAuthn support
  if (!isWebAuthnSupported()) {
    document.getElementById('passkey-support-check').classList.remove('d-none');
    document.getElementById('login-form').classList.add('d-none');
    return;
  }

  // Discoverable credential login (usernameless)
  document.getElementById('passkey-login-btn').addEventListener('click', async function() {
    await attemptLogin();
  });

  // Email-based passkey login
  document.getElementById('email-passkey-btn').addEventListener('click', async function() {
    const email = document.getElementById('email').value.trim();
    if (!email) {
      alert('Please enter your email address');
      return;
    }
    await attemptLogin(email);
  });

  // Auto-trigger if browser supports conditional UI
  if (window.PublicKeyCredential?.isConditionalMediationAvailable) {
    checkConditionalUI();
  }
});

async function checkConditionalUI() {
  try {
    const available = await PublicKeyCredential.isConditionalMediationAvailable();
    if (available) {
      // Browser supports autofill-assisted passkey login
      console.log('Conditional UI available');
    }
  } catch (e) {
    console.log('Conditional UI not supported');
  }
}

async function attemptLogin(email = null) {
  showProgress();
  
  try {
    const result = await loginWithPasskey(email);
    
    if (result.success) {
      showSuccess();
      // Redirect after brief delay
      setTimeout(() => {
        window.location.href = result.redirect || '/dashboard';
      }, 1000);
    } else {
      showError(result.message);
    }
  } catch (error) {
    console.error('Passkey login error:', error);
    showError(error.message || 'Authentication failed. Please try again.');
  }
}

function showProgress() {
  document.getElementById('login-form').classList.add('d-none');
  document.getElementById('login-progress').classList.remove('d-none');
}

function showSuccess() {
  document.getElementById('login-progress').classList.add('d-none');
  document.getElementById('login-success').classList.remove('d-none');
}

function showError(message) {
  document.getElementById('login-progress').classList.add('d-none');
  document.getElementById('error-message').textContent = message;
  document.getElementById('login-error').classList.remove('d-none');
}

function resetForm() {
  document.getElementById('login-error').classList.add('d-none');
  document.getElementById('login-form').classList.remove('d-none');
}
</script>

<%- include('../partials/footer') %>
