<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-4">
  <%- include('partials/messages') %>
  
  <div class="row">
    <div class="col-lg-4 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
            <i class="bi bi-person-fill text-primary profile-icon"></i>
          </div>
          <h4><%= user.firstName || '' %> <%= user.lastName || '' %></h4>
          <p class="text-muted">@<%= user.username %></p>
          <span class="badge bg-<%= user.isVerified ? 'success' : 'warning' %>">
            <%= user.isVerified ? 'Verified' : 'Unverified' %>
          </span>
          <% if (user.role === 'admin') { %>
            <span class="badge bg-danger">Admin</span>
          <% } %>
        </div>
      </div>
      
      <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white">
          <h6 class="mb-0"><i class="bi bi-shield-check"></i> Security Status</h6>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center">
            Email Verified
            <i class="bi bi-<%= user.isVerified ? 'check-circle-fill text-success' : 'x-circle-fill text-danger' %>"></i>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            Two-Factor Auth
            <% if (user.twoFactorEnabled) { %>
              <i class="bi bi-check-circle-fill text-success"></i>
            <% } else { %>
              <a href="/auth/2fa/setup" class="btn btn-sm btn-outline-primary">Enable</a>
            <% } %>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i class="bi bi-pencil"></i> Edit Profile</h5>
        </div>
        <div class="card-body">
          <form action="/users/profile" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="row mb-3">
              <div class="col-md-6">
                <label for="firstName" class="form-label">First Name</label>
                <input type="text" class="form-control" id="firstName" name="firstName" 
                       value="<%= user.firstName || '' %>">
              </div>
              <div class="col-md-6">
                <label for="lastName" class="form-label">Last Name</label>
                <input type="text" class="form-control" id="lastName" name="lastName" 
                       value="<%= user.lastName || '' %>">
              </div>
            </div>
            
            <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <div class="input-group">
                <span class="input-group-text">@</span>
                <input type="text" class="form-control" id="username" name="username" 
                       value="<%= user.username %>" pattern="^[a-zA-Z0-9_]{3,30}$">
              </div>
            </div>
            
            <div class="mb-3">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" class="form-control" id="email" value="<%= user.email %>" disabled>
              <div class="form-text">Contact support to change your email address.</div>
            </div>
            
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check"></i> Save Changes
            </button>
          </form>
        </div>
      </div>
      
      <% if (user.twoFactorEnabled) { %>
      <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i class="bi bi-shield-x"></i> Disable Two-Factor Authentication</h5>
        </div>
        <div class="card-body">
          <form action="/auth/2fa/disable" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" required>
              </div>
              <div class="col-md-6 mb-3">
                <label for="token" class="form-label">2FA Code</label>
                <input type="text" class="form-control" id="token" name="token" 
                       pattern="[0-9]{6}" maxlength="6" placeholder="000000" required>
              </div>
            </div>
            <button type="submit" class="btn btn-danger">
              <i class="bi bi-shield-x"></i> Disable 2FA
            </button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
