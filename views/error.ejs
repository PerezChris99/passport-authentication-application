<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <% if (status === 404) { %>
        <i class="bi bi-question-circle display-1 text-warning"></i>
      <% } else if (status === 403) { %>
        <i class="bi bi-shield-exclamation display-1 text-danger"></i>
      <% } else if (status === 401) { %>
        <i class="bi bi-lock display-1 text-warning"></i>
      <% } else { %>
        <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
      <% } %>
      
      <h1 class="display-4 mt-4"><%= status %></h1>
      <p class="lead text-muted"><%= message %></p>
      
      <div class="mt-4">
        <a href="/" class="btn btn-primary me-2">
          <i class="bi bi-house"></i> Go Home
        </a>
        <button class="btn btn-outline-secondary" data-action="go-back">
          <i class="bi bi-arrow-left"></i> Go Back
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
